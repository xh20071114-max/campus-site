.privacy-mask{position:fixed;z-index:9999;inset:0;display:flex;align-items:center;justify-content:center;padding:40rpx;box-sizing:border-box;background:rgba(16,24,40,.58)}
.privacy-card{width:100%;max-width:640rpx;box-sizing:border-box;padding:36rpx 32rpx 24rpx;border-radius:24rpx;background:#fff;box-shadow:0 20rpx 70rpx rgba(16,24,40,.24);display:flex;flex-direction:column;gap:18rpx}
.privacy-title{font-size:34rpx;font-weight:700;color:#182230;text-align:center}
.privacy-copy{font-size:27rpx;line-height:1.7;color:#475467}
.privacy-link{width:100%;margin:0;background:#fff;color:#173b8f;font-size:26rpx;border:1rpx solid #d0d5dd}
.privacy-agree{width:100%;margin:0;background:#173b8f;color:#fff;font-size:28rpx}
.privacy-deny{width:100%;margin:0;background:#f2f4f7;color:#475467;font-size:26rpx}
