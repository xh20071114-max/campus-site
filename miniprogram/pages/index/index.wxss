.hero{background:linear-gradient(135deg,#edf3ff,#fff)}.hero-copy{line-height:1.7;margin-top:16rpx}.section-head{margin-top:10rpx}.grid{display:grid;grid-template-columns:1fr 1fr;gap:0 16rpx}.channel{display:flex;flex-direction:column;gap:10rpx;min-height:150rpx}.emoji{font-size:34rpx}.channel-name,.announcement-title{font-weight:700}.more{color:#b4232e;font-size:24rpx}.links{margin-top:0}.announcement-text{display:block;white-space:pre-wrap;line-height:1.65;margin-top:10rpx}.task-text{font-weight:600;margin:14rpx 0;line-height:1.6}.foot{padding:18rpx 6rpx;color:#173b8f;font-size:24rpx}
.expand{color:#b4232e;background:transparent;font-size:24rpx;margin:-10rpx auto 20rpx}.expand::after{border:0}.load-error{margin:12rpx 0;padding:18rpx 22rpx;border-radius:14rpx;background:#fff1f1;color:#b4232e;font-size:24rpx;line-height:1.5}
