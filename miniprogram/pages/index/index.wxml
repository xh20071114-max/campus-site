<view class="page"><view class="hero card"><text class="title">同学帮同学，校园生活更轻松</text><view class="muted hero-copy">任务大厅集中发布和接取各类校园任务；校园聊天供大家免费交流。交易进度和私聊在订单里查看。</view><view class="actions"><button class="btn" bindtap="openTasks">浏览可接任务</button><button class="btn light" bindtap="openOrders">我的订单</button></view></view><view wx:if="{{loadError}}" class="load-error" bindtap="load">{{loadError}}</view>
<view class="row section-head"><text class="section-title">功能入口</text><text class="muted">{{channels.length}} 个入口</text></view><view class="grid"><view class="card channel" wx:for="{{channels}}" wx:key="name" data-name="{{item.name}}" bindtap="openChannel"><text class="emoji">{{item.icon}}</text><text class="channel-name">{{item.name}}</text><text class="muted">{{item.count}} {{item.countLabel}}</text></view></view>
<view class="row"><text class="section-title">本周接单榜</text><text class="more" bindtap="openLeaderboard">查看全部 →</text></view><view class="card row links"><text>🏆 排行榜</text><text class="muted">按最终完成订单统计</text></view>
<view class="section-title">平台公告</view><view class="card" wx:for="{{announcements}}" wx:key="id"><view class="row"><text class="announcement-title">{{item.title}}</text><text class="muted">{{item.date}}</text></view><text class="announcement-text" user-select="true">{{item.text}}</text></view><button wx:if="{{allAnnouncements.length>2}}" class="expand" bindtap="toggleAnnouncements">展开 / 收起公告</button><view class="card empty" wx:if="{{!announcements.length}}">暂时没有公告</view>
<view class="row section-head"><text class="section-title">最新可接任务</text><text class="more" bindtap="openTasks">更多 →</text></view><view class="card" wx:for="{{tasks}}" wx:key="id" data-id="{{item.id}}" data-channel="{{item.channel}}" bindtap="openTask"><view class="row"><text class="pill">{{item.typeLabel}}</text><text class="muted">{{item.timeText}}</text></view><view class="task-text">{{item.text}}</view><view class="muted">报酬：{{item.reward||'未填写'}} · {{item.place||'地点待沟通'}}</view></view><view class="card empty" wx:if="{{!tasks.length}}">现在没有待接任务</view>
<view class="foot row"><text bindtap="openMe">{{username?username+' · 个人中心':'登录 / 注册'}}</text><text bindtap="openLeaderboard">接单排行榜</text></view></view>
