<view class="page"><view class="row"><text class="title">未接订单</text><text class="muted">{{total}} 条</text></view><view class="card intro">选择任务后可查看订单详情。接单前会显示积分费用并再次确认。</view>
<view class="card task" wx:for="{{tasks}}" wx:key="id"><view class="row"><text class="pill">{{item.channel}}</text><text class="state">待接单</text></view><view class="task-text">{{item.text}}</view><view class="muted">报酬：{{item.reward||'未填写'}} · 地点：{{item.place||'待沟通'}}</view><view class="muted">发布时间：{{item.timeText}}</view><view class="row bottom"><text class="cost">接单 {{feeReady?(claimCost===0?'免扣':claimCost+' 积分'):'费用规则读取失败'}}</text><button class="btn small" disabled="{{!feeReady}}" data-id="{{item.id}}" data-channel="{{item.channel}}" bindtap="claim">接单</button><button class="btn light small" data-id="{{item.id}}" data-channel="{{item.channel}}" bindtap="detail">详情</button></view></view>
<view class="empty" wx:if="{{!tasks.length}}">暂时没有可接的订单</view><view class="row pager"><button class="btn light small" disabled="{{page<=1}}" bindtap="prev">上一页</button><text class="muted">{{page}} / {{pages}}</text><button class="btn light small" disabled="{{page>=pages}}" bindtap="next">下一页</button></view><view class="notice" wx:if="{{error}}">{{error}}</view></view>

