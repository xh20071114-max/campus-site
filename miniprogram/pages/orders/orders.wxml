<view class="page"><text class="title">我的订单</text><view class="muted intro">查看进度、打开交易私聊，或恢复本人删除的未接任务。</view><view class="tabs"><text class="tab {{view==='active'?'on':''}}" data-view="active" bindtap="switchView">进行中 {{active.length}}</text><text class="tab {{view==='history'?'on':''}}" data-view="history" bindtap="switchView">历史 {{history.length}}</text></view>
<view class="card order" wx:for="{{visible}}" wx:key="id"><view class="row"><text class="pill">{{item.channel}}</text><text class="state {{item.status==='disputed'?'red':''}}">{{item.statusText}}</text></view><view class="order-text">{{item.text||'该订单内容已删除'}}</view><view class="muted">{{item.roleText}} · {{item.timeText}}</view><view class="muted">报酬：{{item.reward||'未填写'}} · 接单人：{{item.claimedBy||'暂无'}}</view><view class="actions"><button wx:if="{{!item.deleted&&!item.formerClaim}}" class="btn" data-id="{{item.id}}" data-channel="{{item.channel}}" bindtap="openTrade">查看订单 / 交易私聊</button><text wx:if="{{item.formerClaim}}" class="muted former-note">本记录不再开放原订单私聊</text><button wx:if="{{item.deleted&&item.status!=='done'&&item.status!=='cancelled'}}" class="btn light" data-id="{{item.id}}" data-channel="{{item.channel}}" bindtap="restore">恢复订单</button></view></view>
<view class="empty" wx:if="{{!visible.length}}">{{view==='active'?'暂时没有进行中的订单':'历史订单会显示在这里'}}</view><view class="notice" wx:if="{{error}}">{{error}}</view></view>
