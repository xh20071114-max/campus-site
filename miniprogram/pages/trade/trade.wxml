<view class="page">
  <view class="card" wx:if="{{task}}">
    <view class="row"><text class="title">{{inquiryMode?'任务咨询':'订单 #'+task.id}}</text><text class="pill">{{inquiryMode?'接单前咨询':statusText}}</text></view>
    <view class="task-text">{{task.text||'该任务内容已删除'}}</view>
    <view class="muted">频道：{{task.channel}} · 发布人：{{task.user}}</view>
    <view class="muted">报酬：{{task.reward||'未填写'}} · 地点：{{task.place||'待沟通'}}</view>
    <view wx:if="{{!inquiryMode}}" class="flow">接单人标记完成 → 发布人确认交付并标记已付款 → 接单人核实到账后确认收款</view>
    <view wx:if="{{inquiryMode&&task.status==='open'}}" class="notice">接单前咨询免费，不会锁定任务。发布人回复后你再决定是否接单。</view>
    <view wx:if="{{task.status==='paid'}}" class="notice">请先在收款账户核实实际到账。网站不会自动代收或代付，也不会自动确认收款。</view>
    <view wx:if="{{task.status==='disputed'}}" class="notice">任务已转交管理员处理，请在私聊中补充必要信息。</view>
    <view class="actions" wx:if="{{canConsult}}"><button class="btn light" bindtap="openInquiry">{{task.myInquiry?'继续咨询发布人':'咨询发布人'}}</button></view>
    <view class="actions" wx:if="{{canViewInquiries}}"><button class="btn light" bindtap="showInquiryThreads">查看咨询 {{task.inquiryUnread?'· '+task.inquiryUnread+' 条未读':''}}</button></view>
    <view class="actions" wx:if="{{canOpenOrder}}"><button class="btn" bindtap="openOrderChat">打开当前订单私聊</button></view>
    <view class="actions" wx:if="{{canCancel}}"><button class="btn danger" data-action="cancel" bindtap="act">撤回未接单任务</button></view>
    <view class="actions" wx:if="{{canClaim}}"><button class="btn" bindtap="claim">确认接单</button></view>
    <view class="actions" wx:if="{{canFinish}}"><button class="btn" data-action="finish" bindtap="act">我已完成</button></view>
    <view class="actions" wx:if="{{canComplete}}"><button class="btn light" data-action="complete" bindtap="act">{{task.bonusPoints&&!task.reward?'确认积分任务完成':'申请免付款完成'}}</button></view>
    <view class="actions" wx:if="{{canPay}}"><button class="btn" data-action="paid" bindtap="act">确认交付并标记已付款</button><button class="btn light" data-action="complete" bindtap="act">申请免付款完成</button></view>
    <view class="actions" wx:if="{{canReceive}}"><button class="btn" data-action="received" bindtap="act">确认已实际到账</button></view>
    <view class="actions" wx:if="{{canFreeDecision}}"><button class="btn" data-action="acceptfree" bindtap="act">确认免付款完成</button><button class="btn light" data-action="declinefree" bindtap="act">不同意，继续交易</button></view>
    <view class="actions" wx:if="{{canWithdrawFree}}"><button class="btn light" data-action="withdrawfree" bindtap="act">撤回免付款申请</button></view>
    <view class="actions" wx:if="{{canUnclaim}}"><button class="btn light" data-action="unclaim" bindtap="act">放弃接单</button></view>
  </view>
  <view class="section-title" wx:if="{{showThreads}}">咨询会话</view>
  <view wx:if="{{showThreads}}" class="thread-list">
    <view class="card thread" wx:for="{{threads}}" wx:key="inquiryId" data-id="{{item.inquiryId}}" bindtap="selectThread">
      <view class="row"><text class="author">{{item.user}}</text><text wx:if="{{item.unread}}" class="unread">{{item.unread}} 条未读</text></view>
      <view class="muted thread-preview">{{item.preview}}</view>
    </view>
    <view class="empty" wx:if="{{!threads.length}}">还没有人咨询这条任务</view>
  </view>
  <view class="section-title" wx:if="{{!showThreads}}">{{inquiryMode?'与发布人咨询':'交易私聊'}}</view>
  <view class="chat-list" wx:if="{{!showThreads}}">
    <view class="bubble {{item.user===username?'mine':''}}" wx:for="{{messages}}" wx:key="id">
      <text class="author">{{item.user}}{{item.type==='system'?' · 系统':''}}</text>
      <text class="bubble-text" wx:if="{{item.text}}">{{item.text}}</text>
      <image wx:if="{{item.localImage}}" src="{{item.localImage}}" mode="widthFix" class="chat-image" data-src="{{item.localImage}}" bindtap="previewImage" binderror="imageError" data-id="{{item.id}}"/>
      <view wx:if="{{item.image&&!item.localImage}}" class="chat-image-fallback {{item.imageStatus==='failed'?'failed':''}}" data-id="{{item.id}}" bindtap="retryImage">{{item.imageStatus==='failed'?'图片加载失败，点此重试':'正在加载图片…'}}</view>
      <text class="muted">{{item.timeText}}</text>
    </view>
    <view class="empty" wx:if="{{!messages.length}}">{{inquiryMode?'还没有咨询消息，可以先发消息给发布人':'暂无私聊消息'}}</view>
  </view>
  <view class="composer" wx:if="{{canWrite}}">
    <textarea class="input compose" maxlength="500" placeholder="{{inquiryMode?'询问任务细节（免费）':'和交易对方沟通细节'}}" value="{{draft}}" bindinput="onDraft"/>
    <view class="row"><button class="btn light" bindtap="chooseImage">发图片</button><button class="btn" loading="{{sending}}" bindtap="send">发送</button></view>
  </view>
  <view class="notice" wx:if="{{error}}">{{error}}</view>
  <privacy-popup id="privacyPopup"/>
</view>
