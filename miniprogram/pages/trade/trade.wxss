.task-text{font-size:30rpx;line-height:1.6;margin:18rpx 0}.flow{margin-top:18rpx;padding:16rpx;background:#edf2ff;color:#173b8f;border-radius:12rpx;line-height:1.7}.chat-list{display:flex;flex-direction:column;gap:14rpx}.bubble{align-self:flex-start;max-width:90%;background:#fff;border-radius:16rpx;padding:18rpx;display:flex;flex-direction:column;gap:10rpx}.bubble.mine{align-self:flex-end;background:#e8efff}.author{font-weight:700;font-size:24rpx}.bubble-text{white-space:pre-wrap;line-height:1.6;overflow-wrap:anywhere}.chat-image{width:420rpx;max-width:100%;border-radius:12rpx}.composer{position:sticky;bottom:0;background:#f4f6fb;padding:14rpx 0 env(safe-area-inset-bottom)}.compose{height:120rpx;margin-bottom:12rpx}.composer .row button{flex:1}.notice{margin-top:16rpx}
