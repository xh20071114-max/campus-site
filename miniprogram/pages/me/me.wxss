.profile{background:linear-gradient(135deg,#edf3ff,#fff)}.balance{font-size:58rpx;color:#173b8f;font-weight:700;margin:22rpx 0}.balance text{font-size:25rpx;font-weight:400}.grid{display:grid;grid-template-columns:1fr 1fr;gap:0 14rpx}.shortcut{display:flex;gap:12rpx;align-items:center;font-weight:600}.shortcut text:first-child{font-size:34rpx}.ledger{padding:20rpx}.delta{font-size:30rpx;color:#16804a;font-weight:700}.delta.red{color:#b4232e}.logout{margin:24rpx auto;color:#b4232e;background:transparent;font-size:26rpx}.logout::after{border:0}
