<view class="page"><view class="card profile"><text class="title">{{username||'我的校园账号'}}</text><view class="muted">{{logged?'账号已登录':'登录后管理订单和积分'}}</view><view class="balance" wx:if="{{logged}}">{{points}} <text>积分</text></view><view class="actions"><button wx:if="{{!logged}}" class="btn" bindtap="login">登录 / 注册</button><button wx:if="{{logged}}" class="btn light" bindtap="recharge">充值积分</button><button wx:if="{{logged}}" class="btn light" bindtap="orders">我的订单</button></view></view><view class="grid"><view class="card shortcut" bindtap="orders"><text>📋</text><text>订单进度</text></view><view class="card shortcut" bindtap="leaderboard"><text>🏆</text><text>接单排行榜</text></view><view class="card shortcut" bindtap="recharge"><text>💳</text><text>积分充值</text></view><view class="card shortcut" bindtap="feedback"><text>💬</text><text>意见反馈</text></view></view><view class="section-title">积分记录</view><view class="card ledger" wx:for="{{ledger}}" wx:key="id"><view class="row"><text>{{item.reason||item.type||'积分变动'}}</text><text class="delta {{item.delta<0?'red':''}}">{{item.delta>0?'+':''}}{{item.delta}}</text></view><text class="muted">{{item.timeText}}</text></view><view class="empty" wx:if="{{logged&&!ledger.length}}">暂无积分流水</view><button wx:if="{{logged}}" class="logout" bindtap="logout">退出登录</button><view class="notice" wx:if="{{error}}">{{error}}</view></view>
