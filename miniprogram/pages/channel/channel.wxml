<view class="page"><view class="row"><text class="title">{{name}}</text><button class="btn small" bindtap="toggleForm">{{showForm?'收起':'发布任务'}}</button></view><view class="muted channel-hint">发布前写清需求，并尽量补充报酬、地点和截止时间；这三项可以留空。</view>
<view class="card form" wx:if="{{showForm}}"><text class="section-title">发布任务</text><textarea class="input detail" maxlength="2000" placeholder="详细描述你的需求" value="{{text}}" bindinput="onText"/><input class="input" maxlength="20" placeholder="报酬（选填，如 5 元）" value="{{reward}}" bindinput="onReward"/><input class="input" maxlength="50" placeholder="地点（选填）" value="{{place}}" bindinput="onPlace"/><view class="row"><picker mode="date" bindchange="onDate"><view class="picker">{{date||'选择截止日期（选填）'}}</view></picker><picker mode="time" bindchange="onTime"><view class="picker">{{time||'选择时间'}}</view></picker></view><view class="muted">发任务需要 {{postCost===0?'免扣':postCost+' 积分'}}</view><button class="btn" loading="{{posting}}" bindtap="publish">确认发布</button></view>
<view class="feed"><view class="card message" wx:for="{{messages}}" wx:key="id"><view class="row"><text class="author">{{item.user}}</text><text class="muted">{{item.timeText}}</text></view><view class="message-text">{{item.text}}</view><view class="muted" wx:if="{{item.task}}">{{item.reward?'报酬：'+item.reward+' · ':''}}{{item.place?'地点：'+item.place+' · ':''}}{{item.deadline?'截止：'+item.deadlineText:''}}</view><view class="row controls" wx:if="{{item.task}}"><text class="pill">{{item.statusText}}</text><button wx:if="{{item.status==='open'&&item.user!==username}}" class="btn small" data-id="{{item.id}}" bindtap="claim">接单</button><button wx:if="{{item.claimedBy===username}}" class="btn light small" data-id="{{item.id}}" bindtap="openTrade">订单私聊</button></view></view><view class="empty" wx:if="{{!messages.length}}">还没有消息或任务</view></view><view class="muted footnote">频道消息每 8 秒自动刷新 · <text bindtap="refresh">立即刷新</text></view><view class="notice" wx:if="{{error}}">{{error}}</view></view>

