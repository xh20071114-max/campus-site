page{background:#f4f6fb;color:#202938;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;font-size:28rpx;box-sizing:border-box}view,text,button,input,textarea{box-sizing:border-box}.page{padding:24rpx}.card{background:#fff;border-radius:20rpx;padding:26rpx;margin-bottom:20rpx;box-shadow:0 6rpx 24rpx rgba(20,45,95,.06)}.title{font-size:38rpx;font-weight:700;color:#173b8f}.muted{color:#667085;font-size:24rpx}.row{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.stack{display:flex;flex-direction:column;gap:14rpx}.btn{background:#173b8f;color:#fff;border-radius:14rpx;font-size:28rpx;line-height:1.4;padding:18rpx 22rpx}.btn::after{border:0}.btn.light{background:#e9efff;color:#173b8f}.btn.danger{background:#c92a36}.notice{background:#fff0f0;color:#b4232e;border-radius:14rpx;padding:18rpx 22rpx;margin-bottom:18rpx}.input{background:#f8fafc;border:1rpx solid #d0d5dd;border-radius:12rpx;padding:18rpx;width:100%;min-height:84rpx}.section-title{font-size:32rpx;font-weight:700;margin:18rpx 0}.pill{display:inline-block;background:#edf2ff;color:#173b8f;padding:6rpx 14rpx;border-radius:999rpx;font-size:22rpx}.empty{text-align:center;color:#667085;padding:44rpx 12rpx}.actions{display:flex;gap:14rpx;margin-top:18rpx}.actions button{flex:1}
